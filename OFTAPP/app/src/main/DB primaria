-- 1. TABLA ROLES
CREATE TABLE IF NOT EXISTS roles (
    id SERIAL PRIMARY KEY,
    codigo VARCHAR(50) NOT NULL UNIQUE,
    nombre VARCHAR(100) NOT NULL,
    descripcion TEXT
);

-- 2. TABLA SUCURSALES
CREATE TABLE IF NOT EXISTS sucursales (
    id SERIAL PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL UNIQUE,
    direccion TEXT,
    ciudad VARCHAR(50) DEFAULT 'Santiago'
);

-- 3. TABLA USUARIOS
CREATE TABLE IF NOT EXISTS usuarios (
    id SERIAL PRIMARY KEY,
    rut VARCHAR(20) NOT NULL UNIQUE,
    nombre VARCHAR(100) NOT NULL,
    apellidos VARCHAR(100) NOT NULL,
    edad INT,
    telefono VARCHAR(30),
    correo VARCHAR(100) NOT NULL UNIQUE,
    clave VARCHAR(100) NOT NULL,
    rol_id INT NOT NULL REFERENCES roles(id),
    sucursal_id INT REFERENCES sucursales(id),
    foto_perfil_uri TEXT,
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 4. TABLA PACIENTES
CREATE TABLE IF NOT EXISTS pacientes (
    id SERIAL PRIMARY KEY,
    rut VARCHAR(20) NOT NULL UNIQUE,
    nombre VARCHAR(100) NOT NULL,
    apellidos VARCHAR(100) NOT NULL,
    edad INT NOT NULL,
    prevision VARCHAR(50) NOT NULL,
    telefono VARCHAR(30),
    correo VARCHAR(100) NOT NULL UNIQUE,
    clave VARCHAR(100) NOT NULL,
    antecedentes TEXT,
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 5. TABLA ATENCIONES
CREATE TABLE IF NOT EXISTS atenciones (
    id SERIAL PRIMARY KEY,
    paciente_id INT NOT NULL REFERENCES pacientes(id) ON DELETE CASCADE,
    medico_id INT REFERENCES usuarios(id) ON DELETE SET NULL,
    sucursal_id INT REFERENCES sucursales(id) ON DELETE SET NULL,
    fecha VARCHAR(50) NOT NULL,
    motivo TEXT NOT NULL,
    estado VARCHAR(50) NOT NULL DEFAULT 'Programada',
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 6. TABLA EXAMENES
CREATE TABLE IF NOT EXISTS examenes (
    id SERIAL PRIMARY KEY,
    paciente_id INT NOT NULL REFERENCES pacientes(id) ON DELETE CASCADE,
    medico_id INT REFERENCES usuarios(id) ON DELETE SET NULL,
    atencion_id INT REFERENCES atenciones(id) ON DELETE SET NULL,
    tipo_examen VARCHAR(100) NOT NULL,
    ojo_evaluado VARCHAR(50) NOT NULL,
    fecha_examen VARCHAR(50) NOT NULL,
    fecha_resolucion VARCHAR(50),
    estado VARCHAR(50) NOT NULL DEFAULT 'Pendiente',
    estado_entrega VARCHAR(50) DEFAULT 'Pendiente de firma',
    descripcion TEXT NOT NULL,
    sucursal VARCHAR(100) NOT NULL,
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 7. TABLA RESULTADOS EXAMEN
CREATE TABLE IF NOT EXISTS resultados_examen (
    id SERIAL PRIMARY KEY,
    examen_id INT NOT NULL UNIQUE REFERENCES examenes(id) ON DELETE CASCADE,
    resumen TEXT NOT NULL,
    observacion TEXT NOT NULL,
    registrado_por VARCHAR(100) NOT NULL,
    fecha_observacion VARCHAR(50) NOT NULL
);

-- 8. TABLA DOCUMENTOS EXAMEN
CREATE TABLE IF NOT EXISTS documentos_examen (
    id SERIAL PRIMARY KEY,
    examen_id INT NOT NULL REFERENCES examenes(id) ON DELETE CASCADE,
    nombre_archivo VARCHAR(255) NOT NULL,
    tipo_archivo VARCHAR(50) NOT NULL,
    tamanio VARCHAR(30) NOT NULL,
    fecha_carga VARCHAR(50) NOT NULL,
    contenido_simulado TEXT
);

-- 9. TABLA CONTROL SINCRONIZACION
CREATE TABLE IF NOT EXISTS sync_log (
    id SERIAL PRIMARY KEY,
    tabla_afectada VARCHAR(50) NOT NULL,
    registro_id INT NOT NULL,
    operacion VARCHAR(20) NOT NULL,
    timestamp BIGINT NOT NULL,
    sincronizado INT DEFAULT 0
);


